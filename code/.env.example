# All variables are optional. The pipeline runs fully offline/free without any of these.

# DATASET_DIR=../dataset
# OUTPUT_PATH=../output.csv

# Set this to enable live LLM evidence extraction for any image/message not
# already covered by code/cache/vision_cache.json or src/message_rules.py.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# TEXT_MODEL=gpt-4o-mini
# VISION_MODEL=gpt-4o-mini
